{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/teacher",
      "destination": "/play/teacher.html"
    },
    {
      "source": "/game",
      "destination": "/play/student.html"
    },
    {
      "source": "/play/teacher",
      "destination": "/play/teacher.html"
    },
    {
      "source": "/play/student",
      "destination": "/play/student.html"
    }
  ]
}